# Copy this file to ".env" and fill in values.
# NEVER commit your real ".env" to git.

# Postgres connection string used by SQLAlchemy/Alembic.
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/sentiment

# Hugging Face token (secret). Create one at:
# https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# Comma-separated list of allowed CORS origins. Example:
# ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

